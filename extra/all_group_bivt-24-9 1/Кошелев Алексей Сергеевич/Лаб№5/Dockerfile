# Образ из предыдущей работы
FROM ket9/otus-devsecops-xss:latest

EXPOSE 8080
# --- Настройки безопасности в Dockerfile ---
# 1. Защита от скачивания лишнего.
# 2. Удаляем SUID/SGID биты для предотвращения повышения привилегий.
RUN find / -xdev -perm /6000 -type f -exec chmod a-s {} \; || true

# Создаем системную группу и пользователя 'appuser' без пароля и домашней директории
RUN groupadd -r appuser_group && useradd -r -g appuser_group appuser

# Выдаем права новому пользователю на рабочую директорию приложения
RUN chown -R appuser:appuser_group /var/www/html

# Переключаемся на непривилегированного пользователя
USER appuser

# Дополнительные флаги безопасности при запуске (docker run)
# Для максимальной защиты контейнер следует запускать с флагами:
# 1. --read-only : Монтирует файловую систему только для чтения.
# 2. --security-opt no-new-privileges : Запрещает процессам повышать свои привилегии.
# 3. --cap-drop=ALL : Сбрасывает все Linux capabilities, оставляя только минимально необходимые.
# 4. -m 512m --cpus 1 : Ограничение ресурсов (защита от DoS-атак).