RUN useradd -m gay
USER gay

# Дополнительные настройки безопасности

# Использовать максимально базовые образы как основу
# дополнительно удалять ненужные пакеты
# прописывать версии образов вместо latest

# Дополнительные флаги

# --read-only : ФС только на чтение
# --security-opt no-new-privileges : запрет на повышение привилегий
# --cap-drop ALL : запрет на линуксовые capabilites (я хз, как их тут нормально перевести)