# Используем твой выбранный образ как базу
FROM tensorflow/tensorflow:nightly-jupyter

# 1. Инструкция EXPOSE (как в примере задания)
EXPOSE 8888

# --- НАСТРОЙКИ БЕЗОПАСНОСТИ ---

# 2. Создаем системного пользователя и группу, чтобы не работать от root
# Используем -m для создания домашней папки (нужна для Jupyter/Tensorflow)
RUN groupadd -r appgroup && useradd -r -g appgroup -m appuser

# 3. Устанавливаем рабочую директорию и даем права пользователю
WORKDIR /app
RUN chown -R appuser:appgroup /app

# 4. Переключаемся на не-root пользователя
USER appuser

# КОММЕНТАРИЙ ПО БЕЗОПАСНОСТИ ДЛЯ ЗАДАНИЯ:
# Другие важные настройки:
# 1. --read-only: при запуске контейнера можно монтировать файловую систему только для чтения.
# 2. --cap-drop=ALL: сброс всех Linux-возможностей (capabilities) и добавление только нужных.
# 3. --no-new-privileges: запрет процессам внутри получать новые привилегии (например, через suid).
# 4. Использование минималистичных образов (Alpine) для уменьшения поверхности атаки.
# 5. Регулярное сканирование образа (Trivy, Clair) — что мы сделаем в Части III.
